    {
      "transform_name": "company_users (mssql)",
      "data_set_name": "accounts-staff-in",
      "field_order": [
        "email_s"
      ],
      "field_mappings": [
        {
          "transform_field": "acc_id_s",
          "data_set_field": "acc_id_s"
        },
        {
          "transform_field": "email_s",
          "data_set_field": "email_s"
        },
        {
          "transform_field": "display_s",
