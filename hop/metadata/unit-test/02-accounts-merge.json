        },
        {
          "transform_field": "status_u",
          "data_set_field": "status_u"
        },
        {
          "transform_field": "last_seen_u",
          "data_set_field": "last_seen_u"
        },
        {
          "transform_field": "created_u",
          "data_set_field": "created_u"
        },
        {
          "transform_field": "side_u",
          "data_set_field": "side_u"
