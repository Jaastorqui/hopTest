{
  "name": "02-accounts-merge",
  "description": "The merge with no database on either side: 2 buyers + 2 staff, one of them the same human. Golden set sits on the last transform; the TableOutput is removed so the test writes nothing.",
  "test_type": "UNIT_TEST",
  "pipeline_filename": "pipelines/02-accounts.hpl",
  "basePath": "",
  "persist_filename": "",
  "autoOpening": true,
  "variableValues": [],
  "database_replacements": [],
  "trans_test_tweaks": [
    {
      "transformName": "→ accounts",
      "tweak": "REMOVE_TRANSFORM"
    }
  ],
  "input_data_sets": [
    {
      "transform_name": "users (mssql)",
      "data_set_name": "accounts-users-in",
      "field_order": [
        "email_u"
      ],
      "field_mappings": [
        {
          "transform_field": "acc_id_u",
          "data_set_field": "acc_id_u"
        },
        {
          "transform_field": "email_u",
          "data_set_field": "email_u"
        },
        {
          "transform_field": "display_u",
          "data_set_field": "display_u"
        },
        {
          "transform_field": "phone",
          "data_set_field": "phone"
        },
        {
          "transform_field": "addresses",
