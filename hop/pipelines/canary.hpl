<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>canary</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>-1</pipeline_status>
    <parameters/>
  </info>
  <transform>
    <name>one row</name>
    <type>RowGenerator</type>
    <fields>
      <field>
        <name>msg</name>
        <type>String</type>
        <nullif>hop headless run ok</nullif>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
    </fields>
    <limit>1</limit>
    <never_ending>N</never_ending>
    <interval_in_ms>5000</interval_in_ms>
    <row_time_field>now</row_time_field>
    <last_time_field>previous</last_time_field>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI><xloc>144</xloc><yloc>128</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>log it</name>
    <type>WriteToLog</type>
    <loglevel>log_level_basic</loglevel>
    <displayHeader>Y</displayHeader>
    <limitRows>N</limitRows>
    <limitRowsNumber>0</limitRowsNumber>
    <logmessage>CANARY</logmessage>
    <fields>
      <field><name>msg</name></field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI><xloc>352</xloc><yloc>128</yloc></GUI>
    <attributes/>
  </transform>
  <order>
    <hop><from>one row</from><to>log it</to><enabled>Y</enabled></hop>
  </order>
  <notepads/>
  <attributes/>
  <transform_error_handling/>
</pipeline>
