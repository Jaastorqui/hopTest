<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>08-order-lines</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>-1</pipeline_status>
    <parameters/>
    <description>order_items -&gt; order_lines. Calculator replaces the generated column.</description>
  </info>
  <transform>
    <name>order_items (mssql)</name>
    <type>TableInput</type>
    <connection>mssql_source</connection>
    <sql>SELECT LOWER(SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;orders:&#x27; + CAST(oi.order_id AS VARCHAR(20))), 2),1,8) + &#x27;-&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;orders:&#x27; + CAST(oi.order_id AS VARCHAR(20))), 2),9,4) + &#x27;-3&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;orders:&#x27; + CAST(oi.order_id AS VARCHAR(20))), 2),14,3) + &#x27;-a&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;orders:&#x27; + CAST(oi.order_id AS VARCHAR(20))), 2),18,3) + &#x27;-&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;orders:&#x27; + CAST(oi.order_id AS VARCHAR(20))), 2),21,12)) AS order_id,
       ROW_NUMBER() OVER (PARTITION BY oi.order_id ORDER BY oi.id) AS line_no,
       LOWER(SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;products:&#x27; + CAST(oi.product_id AS VARCHAR(20))), 2),1,8) + &#x27;-&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;products:&#x27; + CAST(oi.product_id AS VARCHAR(20))), 2),9,4) + &#x27;-3&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;products:&#x27; + CAST(oi.product_id AS VARCHAR(20))), 2),14,3) + &#x27;-a&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;products:&#x27; + CAST(oi.product_id AS VARCHAR(20))), 2),18,3) + &#x27;-&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;products:&#x27; + CAST(oi.product_id AS VARCHAR(20))), 2),21,12)) AS listing_id,
       LOWER(SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;companies:&#x27; + CAST(oi.company_id AS VARCHAR(20))), 2),1,8) + &#x27;-&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;companies:&#x27; + CAST(oi.company_id AS VARCHAR(20))), 2),9,4) + &#x27;-3&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;companies:&#x27; + CAST(oi.company_id AS VARCHAR(20))), 2),14,3) + &#x27;-a&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;companies:&#x27; + CAST(oi.company_id AS VARCHAR(20))), 2),18,3) + &#x27;-&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;companies:&#x27; + CAST(oi.company_id AS VARCHAR(20))), 2),21,12)) AS organisation_id,
       p.sku AS sku_snapshot, p.name AS title_snapshot,
       oi.quantity,
       CAST(ROUND(oi.unit_price * 100, 0) AS BIGINT) AS unit_price_minor,
       CONVERT(VARCHAR(19), o.placed_at, 120) AS placed_at,
       o.status AS order_status
FROM order_items oi
JOIN products p ON p.id = oi.product_id
JOIN orders   o ON o.id = oi.order_id</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lookup/>
    <sql_from_file/>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI><xloc>144</xloc><yloc>96</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>line total</name>
    <type>Calculator</type>
    <description>Was a STORED generated column in the target; computing it here means the number is checkable in the pipeline preview instead of only after the insert.</description>
    <calculation><calc_type>MULTIPLY</calc_type><field_a>quantity</field_a><field_b>unit_price_minor</field_b><field_name>line_total_minor</field_name><remove>N</remove><value_length>-1</value_length><value_precision>-1</value_precision><value_type>Integer</value_type></calculation>
    <failIfNoFile>Y</failIfNoFile>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>320</xloc><yloc>96</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>+ metaunit</name>
    <type>Constant</type>
    <description/>
    <fields>
      <field><name>metaunit</name><type>Integer</type><nullif>111</nullif><length>-1</length><precision>-1</precision><set_empty_string>N</set_empty_string></field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>496</xloc><yloc>96</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>pick target columns</name>
    <type>SelectValues</type>
    <description/>
    <fields>
      <field><name>order_id</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>line_no</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>listing_id</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>organisation_id</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>sku_snapshot</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>title_snapshot</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>quantity</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>unit_price_minor</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>line_total_minor</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>placed_at</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>metaunit</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <select_unspecified>N</select_unspecified>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>656</xloc><yloc>96</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>→ order_lines</name>
    <type>TableOutput</type>
    <description/>
    <connection>mariadb_target</connection>
    <schema/>
    <table>order_lines</table>
    <commit>1000</commit>
    <truncate>N</truncate>
    <only_when_have_rows>N</only_when_have_rows>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <auto_update_table_structure>N</auto_update_table_structure>
    <always_drop_and_recreate>N</always_drop_and_recreate>
    <add_columns>N</add_columns>
    <drop_columns>N</drop_columns>
    <change_column_types>N</change_column_types>
    <fields>
      <field><stream_name>order_id</stream_name><column_name>order_id</column_name></field>
      <field><stream_name>line_no</stream_name><column_name>line_no</column_name></field>
      <field><stream_name>listing_id</stream_name><column_name>listing_id</column_name></field>
      <field><stream_name>organisation_id</stream_name><column_name>organisation_id</column_name></field>
      <field><stream_name>sku_snapshot</stream_name><column_name>sku_snapshot</column_name></field>
      <field><stream_name>title_snapshot</stream_name><column_name>title_snapshot</column_name></field>
      <field><stream_name>quantity</stream_name><column_name>quantity</column_name></field>
      <field><stream_name>unit_price_minor</stream_name><column_name>unit_price_minor</column_name></field>
      <field><stream_name>line_total_minor</stream_name><column_name>line_total_minor</column_name></field>
      <field><stream_name>placed_at</stream_name><column_name>placed_at</column_name></field>
      <field><stream_name>metaunit</stream_name><column_name>metaunit</column_name></field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>816</xloc><yloc>96</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>dates → Oslo</name>
    <type>SelectValues</type>
    <description>Source datetimes are UTC strings (their MS SQL box runs UTC). Declaring the timezone here makes them real instants; the MariaDB session is Europe/Oslo, so they land as Norwegian wall-clock and DST is the zone database&#x27;s problem, not ours.</description>
    <fields>
      <select_unspecified>N</select_unspecified>
      <meta><name>placed_at</name><rename>placed_at</rename><type>Timestamp</type><length>-2</length><precision>-2</precision><conversion_mask>yyyy-MM-dd HH:mm:ss</conversion_mask><date_format_lenient>false</date_format_lenient><date_format_locale/><date_format_timezone>UTC</date_format_timezone><lenient_string_to_number>false</lenient_string_to_number><encoding/><decimal_symbol/><grouping_symbol/><currency_symbol/><storage_type/></meta>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>400</xloc><yloc>96</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>order still live?</name>
    <type>FilterRows</type>
    <description>07 routes cancelled and refunded orders to orders_archive, so their lines have no parent row to point at. Dropping them here is the same decision, stated in the same place you can see it.</description>
    <send_true_to></send_true_to>
    <send_false_to>line total</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>order_status</leftvalue>
        <function>IN LIST</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>cancelled;refunded</text>
          <length>-1</length>
          <precision>0</precision>
          <isnull>N</isnull>
          <mask/>
        </value>
      </condition>
    </compare>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>260</xloc><yloc>96</yloc></GUI>
    <attributes/>
  </transform>
  <order>
    <hop><from>order_items (mssql)</from><to>order still live?</to><enabled>Y</enabled></hop>
    <hop><from>order still live?</from><to>line total</to><enabled>Y</enabled></hop>
    <hop><from>line total</from><to>dates → Oslo</to><enabled>Y</enabled></hop>
    <hop><from>dates → Oslo</from><to>+ metaunit</to><enabled>Y</enabled></hop>
    <hop><from>+ metaunit</from><to>pick target columns</to><enabled>Y</enabled></hop>
    <hop><from>pick target columns</from><to>→ order_lines</to><enabled>Y</enabled></hop>
  </order>
  <notepads/>
  <attributes/>
  <transform_error_handling/>
</pipeline>
