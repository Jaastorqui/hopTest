<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>02-companies</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>-1</pipeline_status>
    <parameters/>
    <description>Their companies -&gt; customer_companies, mi_id resolved by org number.</description>
  </info>
  <transform>
    <name>companies (mssql)</name>
    <type>TableInput</type>
    <connection>mssql_source</connection>
    <sql>-- Re-read the origin for the natural key. org_nr is how this company finds its
-- master id; their c.id is never needed and never stored.
SELECT LTRIM(RTRIM(c.org_number))    AS co_org_nr,
       c.name                        AS co_name,
       LOWER(LTRIM(RTRIM(c.email)))  AS co_email,
       c.phone                       AS co_phone,
       c.address_line1 + N&#x27;, &#x27; + c.postal_code + N&#x27; &#x27; + c.city AS co_description,
       CASE c.status WHEN &#x27;active&#x27; THEN 1 WHEN &#x27;pending&#x27; THEN 0
                     WHEN &#x27;suspended&#x27; THEN 2 ELSE 3 END AS co_status,
       DATEDIFF(SECOND, &#x27;1970-01-01&#x27;, c.created_at) AS metaregtime
FROM companies c</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lookup/>
    <sql_from_file/>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI><xloc>112</xloc><yloc>160</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>master id by org nr</name>
    <type>DBLookup</type>
    <description>Natural key, not a carried id: org number is the thing both systems independently know about the same company.</description>
    <connection>mariadb_target</connection>
    <cache>Y</cache>
    <cache_load_all>Y</cache_load_all>
    <cache_size>0</cache_size>
    <lookup>
      <schema/>
      <table>customer_master_id_lookup</table>
      <orderby/>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
      <key><name>co_org_nr</name><field>mi_org_nr</field><condition>=</condition><name2/></key>
      <value><name>mi_id</name><rename>mi_id</rename><default>0</default><type>Integer</type></value>
    </lookup>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>288</xloc><yloc>160</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>already a Melvis company?</name>
    <type>DBLookup</type>
    <description>The 80 matched master ids already have our company row in them.</description>
    <connection>mariadb_target</connection>
    <cache>Y</cache>
    <cache_load_all>Y</cache_load_all>
    <cache_size>0</cache_size>
    <lookup>
      <schema/>
      <table>customer_companies</table>
      <orderby/>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
      <key><name>mi_id</name><field>mi_id</field><condition>=</condition><name2/></key>
      <value><name>co_id</name><rename>existing_co_id</rename><default>0</default><type>Integer</type></value>
    </lookup>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>464</xloc><yloc>160</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>defaults</name>
    <type>Calculator</type>
    <description/>
    <calculation><calc_type>CONSTANT</calc_type><field_a>0</field_a><field_name>co_blacklist</field_name><remove>N</remove><value_length>-1</value_length><value_precision>-1</value_precision><value_type>Integer</value_type></calculation>
    <calculation><calc_type>CONSTANT</calc_type><field_a>0</field_a><field_name>co_parent</field_name><remove>N</remove><value_length>-1</value_length><value_precision>-1</value_precision><value_type>Integer</value_type></calculation>
    <calculation><calc_type>CONSTANT</calc_type><field_a>1</field_a><field_name>co_exist_status</field_name><remove>N</remove><value_length>-1</value_length><value_precision>-1</value_precision><value_type>Integer</value_type></calculation>
    <calculation><calc_type>CONSTANT</calc_type><field_a>1</field_a><field_name>metaunit</field_name><remove>N</remove><value_length>-1</value_length><value_precision>-1</value_precision><value_type>Integer</value_type></calculation>
    <failIfNoFile>Y</failIfNoFile>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>624</xloc><yloc>160</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>new to Melvis?</name>
    <type>FilterRows</type>
    <description>An acquisition does not get to overwrite our own customer data.</description>
    <send_true_to>pick target columns</send_true_to>
    <send_false_to></send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>existing_co_id</leftvalue>
        <function>=</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>Integer</type>
          <text>0</text>
          <length>-1</length>
          <precision>0</precision>
          <isnull>N</isnull>
          <mask/>
        </value>
      </condition>
    </compare>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>784</xloc><yloc>160</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>pick target columns</name>
    <type>SelectValues</type>
    <description/>
    <fields>
      <field><name>mi_id</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>co_org_nr</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>co_name</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>co_status</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>co_email</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>co_phone</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>co_description</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>co_blacklist</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>co_parent</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>co_exist_status</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>metaregtime</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>metaunit</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <select_unspecified>N</select_unspecified>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>960</xloc><yloc>160</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>→ customer_companies</name>
    <type>TableOutput</type>
    <description/>
    <connection>mariadb_target</connection>
    <schema/>
    <table>customer_companies</table>
    <commit>1000</commit>
    <truncate>N</truncate>
    <only_when_have_rows>N</only_when_have_rows>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field></return_field>
    <auto_update_table_structure>N</auto_update_table_structure>
    <always_drop_and_recreate>N</always_drop_and_recreate>
    <add_columns>N</add_columns>
    <drop_columns>N</drop_columns>
    <change_column_types>N</change_column_types>
    <fields>
      <field><stream_name>mi_id</stream_name><column_name>mi_id</column_name></field>
      <field><stream_name>co_org_nr</stream_name><column_name>co_org_nr</column_name></field>
      <field><stream_name>co_name</stream_name><column_name>co_name</column_name></field>
      <field><stream_name>co_status</stream_name><column_name>co_status</column_name></field>
      <field><stream_name>co_email</stream_name><column_name>co_email</column_name></field>
      <field><stream_name>co_phone</stream_name><column_name>co_phone</column_name></field>
      <field><stream_name>co_description</stream_name><column_name>co_description</column_name></field>
      <field><stream_name>co_blacklist</stream_name><column_name>co_blacklist</column_name></field>
      <field><stream_name>co_parent</stream_name><column_name>co_parent</column_name></field>
      <field><stream_name>co_exist_status</stream_name><column_name>co_exist_status</column_name></field>
      <field><stream_name>metaregtime</stream_name><column_name>metaregtime</column_name></field>
      <field><stream_name>metaunit</stream_name><column_name>metaunit</column_name></field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>1136</xloc><yloc>160</yloc></GUI>
    <attributes/>
  </transform>
  <order>
    <hop><from>companies (mssql)</from><to>master id by org nr</to><enabled>Y</enabled></hop>
    <hop><from>master id by org nr</from><to>already a Melvis company?</to><enabled>Y</enabled></hop>
    <hop><from>already a Melvis company?</from><to>defaults</to><enabled>Y</enabled></hop>
    <hop><from>defaults</from><to>new to Melvis?</to><enabled>Y</enabled></hop>
    <hop><from>new to Melvis?</from><to>pick target columns</to><enabled>Y</enabled></hop>
    <hop><from>pick target columns</from><to>→ customer_companies</to><enabled>Y</enabled></hop>
  </order>
  <notepads/>
  <attributes/>
  <transform_error_handling/>
</pipeline>
