<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>02-accounts</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>-1</pipeline_status>
    <parameters/>
    <description>users FULL OUTER company_users on email -&gt; accounts. The merge is a Merge join transform, not a UNION in SQL: you can see the row counts on each leg.</description>
  </info>
  <transform>
    <name>users (mssql)</name>
    <type>TableInput</type>
    <description>Their buyers. 3000 rows, email unique.</description>
    <connection>mssql_source</connection>
    <sql>SELECT LOWER(SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;account:&#x27; + LOWER(LTRIM(RTRIM(u.email)))), 2),1,8) + &#x27;-&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;account:&#x27; + LOWER(LTRIM(RTRIM(u.email)))), 2),9,4) + &#x27;-3&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;account:&#x27; + LOWER(LTRIM(RTRIM(u.email)))), 2),14,3) + &#x27;-a&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;account:&#x27; + LOWER(LTRIM(RTRIM(u.email)))), 2),18,3) + &#x27;-&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;account:&#x27; + LOWER(LTRIM(RTRIM(u.email)))), 2),21,12)) AS acc_id_u,
       LOWER(LTRIM(RTRIM(u.email))) AS email_u,
       u.first_name + N&#x27; &#x27; + u.last_name AS display_u,
       u.phone AS phone,
       (SELECT a.kind AS kind, a.line1 AS line1, a.line2 AS line2,
               a.postal_code AS postal_code, a.city AS city, a.country AS country
        FROM addresses a WHERE a.user_id = u.id FOR JSON PATH) AS addresses,
       CASE WHEN u.is_active = 1 THEN &#x27;active&#x27; ELSE &#x27;disabled&#x27; END AS status_u,
       CONVERT(VARCHAR(19), u.last_login_at, 120) AS last_seen_u,
       CONVERT(VARCHAR(19), u.created_at, 120) AS created_u,
       &#x27;buyer&#x27; AS side_u
FROM users u
ORDER BY LOWER(LTRIM(RTRIM(u.email)))</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lookup/>
    <sql_from_file/>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI><xloc>112</xloc><yloc>64</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>company_users (mssql)</name>
    <type>TableInput</type>
    <description>Their seller staff. 625 rows, email unique.</description>
    <connection>mssql_source</connection>
    <sql>SELECT LOWER(SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;account:&#x27; + LOWER(LTRIM(RTRIM(cu.email)))), 2),1,8) + &#x27;-&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;account:&#x27; + LOWER(LTRIM(RTRIM(cu.email)))), 2),9,4) + &#x27;-3&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;account:&#x27; + LOWER(LTRIM(RTRIM(cu.email)))), 2),14,3) + &#x27;-a&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;account:&#x27; + LOWER(LTRIM(RTRIM(cu.email)))), 2),18,3) + &#x27;-&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;account:&#x27; + LOWER(LTRIM(RTRIM(cu.email)))), 2),21,12)) AS acc_id_s,
       LOWER(LTRIM(RTRIM(cu.email))) AS email_s,
       cu.full_name AS display_s,
       CASE WHEN cu.is_active = 1 THEN &#x27;active&#x27; ELSE &#x27;disabled&#x27; END AS status_s,
       CONVERT(VARCHAR(19), cu.last_login_at, 120) AS last_seen_s,
       CONVERT(VARCHAR(19), cu.created_at, 120) AS created_s,
       &#x27;staff&#x27; AS side_s
FROM company_users cu
ORDER BY LOWER(LTRIM(RTRIM(cu.email)))</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lookup/>
    <sql_from_file/>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI><xloc>112</xloc><yloc>240</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>sort buyers</name>
    <type>SortRows</type>
    <description>The SQL already ordered these, but MS SQL collation and Hop string comparison are not the same ordering. Merge join trusts the stream, so sort it in Hop.</description>
    <directory>${java.io.tmpdir}</directory>
    <prefix>srt</prefix>
    <sort_size>100000</sort_size>
    <free_memory/>
    <compress>N</compress>
    <compress_variable/>
    <unique_rows>N</unique_rows>
    <fields>
      <field><name>email_u</name><ascending>Y</ascending><case_sensitive>N</case_sensitive><collator_enabled>N</collator_enabled><collator_strength>0</collator_strength><presorted>N</presorted></field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>272</xloc><yloc>64</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>sort staff</name>
    <type>SortRows</type>
    <description/>
    <directory>${java.io.tmpdir}</directory>
    <prefix>srt</prefix>
    <sort_size>100000</sort_size>
    <free_memory/>
    <compress>N</compress>
    <compress_variable/>
    <unique_rows>N</unique_rows>
    <fields>
      <field><name>email_s</name><ascending>Y</ascending><case_sensitive>N</case_sensitive><collator_enabled>N</collator_enabled><collator_strength>0</collator_strength><presorted>N</presorted></field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>272</xloc><yloc>240</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>merge on email</name>
    <type>MergeJoin</type>
    <description>The whole acquisition in one transform: 3000 buyers FULL OUTER 625 staff on email = 3565 humans. 60 of them were two rows in their database and are one row in ours.</description>
    <join_type>FULL OUTER</join_type>
    <keys_1>
      <key>email_u</key>
    </keys_1>
    <keys_2>
      <key>email_s</key>
    </keys_2>
    <transform1>sort buyers</transform1>
    <transform2>sort staff</transform2>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>448</xloc><yloc>152</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>which sides matched</name>
    <type>ConcatFields</type>
    <description>Unmatched side comes through empty, so the concatenation says which branch(es) fired.</description>
    <ConcatFields><removeSelectedFields>N</removeSelectedFields><targetFieldLength>0</targetFieldLength><targetFieldName>sides</targetFieldName></ConcatFields>
    <enclosure/>
    <fields>
      <field><currency/><decimal/><format/><group/><length>-1</length><name>side_u</name><nullif/><precision>-1</precision><trim_type>both</trim_type><type>String</type></field>
      <field><currency/><decimal/><format/><group/><length>-1</length><name>side_s</name><nullif/><precision>-1</precision><trim_type>both</trim_type><type>String</type></field>
    </fields>
    <separator></separator>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>608</xloc><yloc>152</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>merge_source</name>
    <type>ValueMapper</type>
    <description>buyerstaff = the same human on both sides. That is the row the merge actually created.</description>
    <field_to_use>sides</field_to_use>
    <target_field>merge_source</target_field>
    <non_match_default>buyer</non_match_default>
    <fields>
      <field><source_value>buyerstaff</source_value><target_value>both</target_value></field>
      <field><source_value>buyer</source_value><target_value>buyer</target_value></field>
      <field><source_value>staff</source_value><target_value>staff</target_value></field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>736</xloc><yloc>152</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>take best value</name>
    <type>Coalesce</type>
    <description>Buyer row wins where both exist: it has the phone and the addresses. Staff row fills the gaps for the 565 staff who never bought anything.</description>
    <fields>
      <field><input>acc_id_u, acc_id_s</input><name>id</name><remove>N</remove><type>String</type></field>
      <field><input>email_u, email_s</input><name>email</name><remove>N</remove><type>String</type></field>
      <field><input>display_u, display_s</input><name>display_name</name><remove>N</remove><type>String</type></field>
      <field><input>status_u, status_s</input><name>status</name><remove>N</remove><type>String</type></field>
      <field><input>last_seen_u, last_seen_s</input><name>last_seen_at</name><remove>N</remove><type>String</type></field>
      <field><input>created_u, created_s</input><name>created_at</name><remove>N</remove><type>String</type></field>
    </fields>
    <empty_is_null>Y</empty_is_null>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>880</xloc><yloc>152</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>+ metaunit</name>
    <type>Constant</type>
    <description/>
    <fields>
      <field><name>metaunit</name><type>Integer</type><nullif>111</nullif><length>-1</length><precision>-1</precision><set_empty_string>N</set_empty_string></field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>1024</xloc><yloc>152</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>pick target columns</name>
    <type>SelectValues</type>
    <description/>
    <fields>
      <field><name>id</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>email</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>display_name</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>phone</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>addresses</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>status</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>merge_source</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>last_seen_at</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>created_at</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>metaunit</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <select_unspecified>N</select_unspecified>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>1168</xloc><yloc>152</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>→ accounts</name>
    <type>TableOutput</type>
    <description/>
    <connection>mariadb_target</connection>
    <schema/>
    <table>accounts</table>
    <commit>1000</commit>
    <truncate>N</truncate>
    <only_when_have_rows>N</only_when_have_rows>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <auto_update_table_structure>N</auto_update_table_structure>
    <always_drop_and_recreate>N</always_drop_and_recreate>
    <add_columns>N</add_columns>
    <drop_columns>N</drop_columns>
    <change_column_types>N</change_column_types>
    <fields>
      <field><stream_name>id</stream_name><column_name>id</column_name></field>
      <field><stream_name>email</stream_name><column_name>email</column_name></field>
      <field><stream_name>display_name</stream_name><column_name>display_name</column_name></field>
      <field><stream_name>phone</stream_name><column_name>phone</column_name></field>
      <field><stream_name>addresses</stream_name><column_name>addresses</column_name></field>
      <field><stream_name>status</stream_name><column_name>status</column_name></field>
      <field><stream_name>merge_source</stream_name><column_name>merge_source</column_name></field>
      <field><stream_name>last_seen_at</stream_name><column_name>last_seen_at</column_name></field>
      <field><stream_name>created_at</stream_name><column_name>created_at</column_name></field>
      <field><stream_name>metaunit</stream_name><column_name>metaunit</column_name></field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>1312</xloc><yloc>152</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>dates → Oslo</name>
    <type>SelectValues</type>
    <description>Source datetimes are UTC strings (their MS SQL box runs UTC). Declaring the timezone here makes them real instants; the MariaDB session is Europe/Oslo, so they land as Norwegian wall-clock and DST is the zone database&#x27;s problem, not ours.</description>
    <fields>
      <select_unspecified>N</select_unspecified>
      <meta><name>last_seen_at</name><rename>last_seen_at</rename><type>Timestamp</type><length>-2</length><precision>-2</precision><conversion_mask>yyyy-MM-dd HH:mm:ss</conversion_mask><date_format_lenient>false</date_format_lenient><date_format_locale/><date_format_timezone>UTC</date_format_timezone><lenient_string_to_number>false</lenient_string_to_number><encoding/><decimal_symbol/><grouping_symbol/><currency_symbol/><storage_type/></meta>
      <meta><name>created_at</name><rename>created_at</rename><type>Timestamp</type><length>-2</length><precision>-2</precision><conversion_mask>yyyy-MM-dd HH:mm:ss</conversion_mask><date_format_lenient>false</date_format_lenient><date_format_locale/><date_format_timezone>UTC</date_format_timezone><lenient_string_to_number>false</lenient_string_to_number><encoding/><decimal_symbol/><grouping_symbol/><currency_symbol/><storage_type/></meta>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>952</xloc><yloc>64</yloc></GUI>
    <attributes/>
  </transform>
  <order>
    <hop><from>users (mssql)</from><to>sort buyers</to><enabled>Y</enabled></hop>
    <hop><from>company_users (mssql)</from><to>sort staff</to><enabled>Y</enabled></hop>
    <hop><from>sort buyers</from><to>merge on email</to><enabled>Y</enabled></hop>
    <hop><from>sort staff</from><to>merge on email</to><enabled>Y</enabled></hop>
    <hop><from>merge on email</from><to>which sides matched</to><enabled>Y</enabled></hop>
    <hop><from>which sides matched</from><to>merge_source</to><enabled>Y</enabled></hop>
    <hop><from>merge_source</from><to>take best value</to><enabled>Y</enabled></hop>
    <hop><from>take best value</from><to>dates → Oslo</to><enabled>Y</enabled></hop>
    <hop><from>dates → Oslo</from><to>+ metaunit</to><enabled>Y</enabled></hop>
    <hop><from>+ metaunit</from><to>pick target columns</to><enabled>Y</enabled></hop>
    <hop><from>pick target columns</from><to>→ accounts</to><enabled>Y</enabled></hop>
  </order>
  <notepads/>
  <attributes/>
  <transform_error_handling/>
</pipeline>
