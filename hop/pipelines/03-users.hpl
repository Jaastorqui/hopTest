<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>03-users</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>-1</pipeline_status>
    <parameters/>
    <description>users + company_users -&gt; customer_users, skipping people Melvis already knows.</description>
  </info>
  <transform>
    <name>users (mssql)</name>
    <type>TableInput</type>
    <connection>mssql_source</connection>
    <sql>SELECT LOWER(LTRIM(RTRIM(u.email))) AS email_u, u.first_name AS first_u,
       u.last_name AS last_u, u.password_hash AS hash_u, u.phone AS phone_u,
       CASE WHEN u.is_active = 1 THEN 1 ELSE 0 END AS status_u,
       DATEDIFF(SECOND, &#x27;1970-01-01&#x27;, u.created_at) AS reg_u, &#x27;buyer&#x27; AS side_u
FROM users u ORDER BY LOWER(LTRIM(RTRIM(u.email)))</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lookup/>
    <sql_from_file/>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI><xloc>112</xloc><yloc>64</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>company_users (mssql)</name>
    <type>TableInput</type>
    <connection>mssql_source</connection>
    <sql>SELECT LOWER(LTRIM(RTRIM(cu.email))) AS email_s,
       LEFT(cu.full_name, CHARINDEX(&#x27; &#x27;, cu.full_name + &#x27; &#x27;) - 1) AS first_s,
       LTRIM(SUBSTRING(cu.full_name, CHARINDEX(&#x27; &#x27;, cu.full_name + &#x27; &#x27;), 200)) AS last_s,
       cu.password_hash AS hash_s,
       CASE WHEN cu.is_active = 1 THEN 1 ELSE 0 END AS status_s,
       DATEDIFF(SECOND, &#x27;1970-01-01&#x27;, cu.created_at) AS reg_s, &#x27;staff&#x27; AS side_s
FROM company_users cu ORDER BY LOWER(LTRIM(RTRIM(cu.email)))</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lookup/>
    <sql_from_file/>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI><xloc>112</xloc><yloc>240</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>sort buyers</name>
    <type>SortRows</type>
    <description/>
    <directory>${java.io.tmpdir}</directory>
    <prefix>srt</prefix>
    <sort_size>100000</sort_size>
    <free_memory/>
    <compress>N</compress>
    <compress_variable/>
    <unique_rows>N</unique_rows>
    <fields>
      <field><name>email_u</name><ascending>Y</ascending><case_sensitive>N</case_sensitive><collator_enabled>N</collator_enabled><collator_strength>0</collator_strength><presorted>N</presorted></field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>256</xloc><yloc>64</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>sort staff</name>
    <type>SortRows</type>
    <description/>
    <directory>${java.io.tmpdir}</directory>
    <prefix>srt</prefix>
    <sort_size>100000</sort_size>
    <free_memory/>
    <compress>N</compress>
    <compress_variable/>
    <unique_rows>N</unique_rows>
    <fields>
      <field><name>email_s</name><ascending>Y</ascending><case_sensitive>N</case_sensitive><collator_enabled>N</collator_enabled><collator_strength>0</collator_strength><presorted>N</presorted></field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>256</xloc><yloc>240</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>merge on email</name>
    <type>MergeJoin</type>
    <description>Same merge as before: one human, one customer_users row, whichever of their two tables they appeared in.</description>
    <join_type>FULL OUTER</join_type>
    <keys_1>
      <key>email_u</key>
    </keys_1>
    <keys_2>
      <key>email_s</key>
    </keys_2>
    <transform1>sort buyers</transform1>
    <transform2>sort staff</transform2>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>416</xloc><yloc>152</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>take best value</name>
    <type>Coalesce</type>
    <description>Buyer row wins: it is the one with a phone number.</description>
    <fields>
      <field><input>email_u, email_s</input><name>us_email</name><remove>N</remove><type>String</type></field>
      <field><input>first_u, first_s</input><name>us_first_name</name><remove>N</remove><type>String</type></field>
      <field><input>last_u, last_s</input><name>us_last_name</name><remove>N</remove><type>String</type></field>
      <field><input>hash_u, hash_s</input><name>us_hash</name><remove>N</remove><type>String</type></field>
      <field><input>status_u, status_s</input><name>us_status</name><remove>N</remove><type>Integer</type></field>
      <field><input>reg_u, reg_s</input><name>metaregtime</name><remove>N</remove><type>Integer</type></field>
    </fields>
    <empty_is_null>Y</empty_is_null>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>576</xloc><yloc>152</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>rename phone</name>
    <type>SelectValues</type>
    <description/>
    <fields>
      <field><name>us_email</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>us_first_name</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>us_last_name</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>us_hash</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>phone_u</name><rename>us_phone</rename><length>-2</length><precision>-2</precision></field>
      <field><name>us_status</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>metaregtime</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <select_unspecified>N</select_unspecified>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>720</xloc><yloc>152</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>already a Melvis user?</name>
    <type>DBLookup</type>
    <description>us_email is UNIQUE in Melvis. 120 of theirs are already ours - the acquisition is the second time we meet these people, not the first.</description>
    <connection>mariadb_target</connection>
    <cache>Y</cache>
    <cache_load_all>Y</cache_load_all>
    <cache_size>0</cache_size>
    <lookup>
      <schema/>
      <table>customer_users</table>
      <orderby/>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
      <key><name>us_email</name><field>us_email</field><condition>=</condition><name2/></key>
      <value><name>us_id</name><rename>existing_us_id</rename><default>0</default><type>Integer</type></value>
    </lookup>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>864</xloc><yloc>152</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>defaults</name>
    <type>Calculator</type>
    <description/>
    <calculation><calc_type>CONSTANT</calc_type><field_a>1</field_a><field_name>us_type</field_name><remove>N</remove><value_length>-1</value_length><value_precision>-1</value_precision><value_type>Integer</value_type></calculation>
    <calculation><calc_type>CONSTANT</calc_type><field_a>1</field_a><field_name>metaunit</field_name><remove>N</remove><value_length>-1</value_length><value_precision>-1</value_precision><value_type>Integer</value_type></calculation>
    <failIfNoFile>Y</failIfNoFile>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>1008</xloc><yloc>152</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>new to Melvis?</name>
    <type>FilterRows</type>
    <description>A duplicate insert would hit unique_email and fail the run; silently updating ours from theirs would be worse.</description>
    <send_true_to>pick target columns</send_true_to>
    <send_false_to></send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>existing_us_id</leftvalue>
        <function>=</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>Integer</type>
          <text>0</text>
          <length>-1</length>
          <precision>0</precision>
          <isnull>N</isnull>
          <mask/>
        </value>
      </condition>
    </compare>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>1152</xloc><yloc>152</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>pick target columns</name>
    <type>SelectValues</type>
    <description/>
    <fields>
      <field><name>us_first_name</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>us_last_name</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>us_email</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>us_hash</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>us_phone</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>us_status</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>us_type</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>metaregtime</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>metaunit</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <select_unspecified>N</select_unspecified>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>1312</xloc><yloc>152</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>→ customer_users</name>
    <type>TableOutput</type>
    <description/>
    <connection>mariadb_target</connection>
    <schema/>
    <table>customer_users</table>
    <commit>1000</commit>
    <truncate>N</truncate>
    <only_when_have_rows>N</only_when_have_rows>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field></return_field>
    <auto_update_table_structure>N</auto_update_table_structure>
    <always_drop_and_recreate>N</always_drop_and_recreate>
    <add_columns>N</add_columns>
    <drop_columns>N</drop_columns>
    <change_column_types>N</change_column_types>
    <fields>
      <field><stream_name>us_first_name</stream_name><column_name>us_first_name</column_name></field>
      <field><stream_name>us_last_name</stream_name><column_name>us_last_name</column_name></field>
      <field><stream_name>us_email</stream_name><column_name>us_email</column_name></field>
      <field><stream_name>us_hash</stream_name><column_name>us_hash</column_name></field>
      <field><stream_name>us_phone</stream_name><column_name>us_phone</column_name></field>
      <field><stream_name>us_status</stream_name><column_name>us_status</column_name></field>
      <field><stream_name>us_type</stream_name><column_name>us_type</column_name></field>
      <field><stream_name>metaregtime</stream_name><column_name>metaregtime</column_name></field>
      <field><stream_name>metaunit</stream_name><column_name>metaunit</column_name></field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>1472</xloc><yloc>152</yloc></GUI>
    <attributes/>
  </transform>
  <order>
    <hop><from>users (mssql)</from><to>sort buyers</to><enabled>Y</enabled></hop>
    <hop><from>company_users (mssql)</from><to>sort staff</to><enabled>Y</enabled></hop>
    <hop><from>sort buyers</from><to>merge on email</to><enabled>Y</enabled></hop>
    <hop><from>sort staff</from><to>merge on email</to><enabled>Y</enabled></hop>
    <hop><from>merge on email</from><to>take best value</to><enabled>Y</enabled></hop>
    <hop><from>take best value</from><to>rename phone</to><enabled>Y</enabled></hop>
    <hop><from>rename phone</from><to>already a Melvis user?</to><enabled>Y</enabled></hop>
    <hop><from>already a Melvis user?</from><to>defaults</to><enabled>Y</enabled></hop>
    <hop><from>defaults</from><to>new to Melvis?</to><enabled>Y</enabled></hop>
    <hop><from>new to Melvis?</from><to>pick target columns</to><enabled>Y</enabled></hop>
    <hop><from>pick target columns</from><to>→ customer_users</to><enabled>Y</enabled></hop>
  </order>
  <notepads/>
  <attributes/>
  <transform_error_handling/>
</pipeline>
