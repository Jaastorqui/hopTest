<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>10-auth-events</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>-1</pipeline_status>
    <parameters/>
    <description>login_events -&gt; auth_events + auth_summary. One stream copied to a detail table and a group by.</description>
  </info>
  <transform>
    <name>login_events (mssql)</name>
    <type>TableInput</type>
    <connection>mssql_source</connection>
    <sql>SELECT LOWER(SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;account:&#x27; + LOWER(LTRIM(RTRIM(COALESCE(u.email, cu.email))))), 2),1,8) + &#x27;-&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;account:&#x27; + LOWER(LTRIM(RTRIM(COALESCE(u.email, cu.email))))), 2),9,4) + &#x27;-3&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;account:&#x27; + LOWER(LTRIM(RTRIM(COALESCE(u.email, cu.email))))), 2),14,3) + &#x27;-a&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;account:&#x27; + LOWER(LTRIM(RTRIM(COALESCE(u.email, cu.email))))), 2),18,3) + &#x27;-&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;account:&#x27; + LOWER(LTRIM(RTRIM(COALESCE(u.email, cu.email))))), 2),21,12)) AS account_id,
       CONVERT(VARCHAR(19), le.occurred_at, 120) AS occurred_at,
       &#x27;password&#x27; AS provider,
       CAST(CAST(PARSENAME(le.ip_address, 4) AS TINYINT) AS BINARY(1))
     + CAST(CAST(PARSENAME(le.ip_address, 3) AS TINYINT) AS BINARY(1))
     + CAST(CAST(PARSENAME(le.ip_address, 2) AS TINYINT) AS BINARY(1))
     + CAST(CAST(PARSENAME(le.ip_address, 1) AS TINYINT) AS BINARY(1)) AS ip_address,
       le.user_agent, le.success
FROM login_events le
LEFT JOIN users u         ON le.principal_type = &#x27;user&#x27;  AND u.id  = le.principal_id
LEFT JOIN company_users cu ON le.principal_type = &#x27;staff&#x27; AND cu.id = le.principal_id
WHERE COALESCE(u.email, cu.email) IS NOT NULL</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lookup/>
    <sql_from_file/>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI><xloc>112</xloc><yloc>160</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>+ metaunit</name>
    <type>Constant</type>
    <description/>
    <fields>
      <field><name>metaunit</name><type>Integer</type><nullif>111</nullif><length>-1</length><precision>-1</precision><set_empty_string>N</set_empty_string></field>
    </fields>
    <distribute>N</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>288</xloc><yloc>160</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>pick target columns</name>
    <type>SelectValues</type>
    <description/>
    <fields>
      <field><name>account_id</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>occurred_at</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>provider</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>ip_address</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>user_agent</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>success</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>metaunit</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <select_unspecified>N</select_unspecified>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>464</xloc><yloc>64</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>→ auth_events</name>
    <type>TableOutput</type>
    <description/>
    <connection>mariadb_target</connection>
    <schema/>
    <table>auth_events</table>
    <commit>1000</commit>
    <truncate>N</truncate>
    <only_when_have_rows>N</only_when_have_rows>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <auto_update_table_structure>N</auto_update_table_structure>
    <always_drop_and_recreate>N</always_drop_and_recreate>
    <add_columns>N</add_columns>
    <drop_columns>N</drop_columns>
    <change_column_types>N</change_column_types>
    <fields>
      <field><stream_name>account_id</stream_name><column_name>account_id</column_name></field>
      <field><stream_name>occurred_at</stream_name><column_name>occurred_at</column_name></field>
      <field><stream_name>provider</stream_name><column_name>provider</column_name></field>
      <field><stream_name>ip_address</stream_name><column_name>ip_address</column_name></field>
      <field><stream_name>user_agent</stream_name><column_name>user_agent</column_name></field>
      <field><stream_name>success</stream_name><column_name>success</column_name></field>
      <field><stream_name>metaunit</stream_name><column_name>metaunit</column_name></field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>640</xloc><yloc>64</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>failure flag</name>
    <type>Calculator</type>
    <description>success is 1/0, so 1 - success is the thing worth counting.</description>
    <calculation><calc_type>CONSTANT</calc_type><field_a>1</field_a><field_name>one</field_name><remove>Y</remove><value_length>-1</value_length><value_precision>-1</value_precision><value_type>Integer</value_type></calculation>
    <calculation><calc_type>SUBTRACT</calc_type><field_a>one</field_a><field_b>success</field_b><field_name>failure</field_name><remove>N</remove><value_length>-1</value_length><value_precision>-1</value_precision><value_type>Integer</value_type></calculation>
    <failIfNoFile>Y</failIfNoFile>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>464</xloc><yloc>272</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>sort by account</name>
    <type>SortRows</type>
    <description>Group by aggregates consecutive rows only.</description>
    <directory>${java.io.tmpdir}</directory>
    <prefix>srt</prefix>
    <sort_size>100000</sort_size>
    <free_memory/>
    <compress>N</compress>
    <compress_variable/>
    <unique_rows>N</unique_rows>
    <fields>
      <field><name>account_id</name><ascending>Y</ascending><case_sensitive>N</case_sensitive><collator_enabled>N</collator_enabled><collator_strength>0</collator_strength><presorted>N</presorted></field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>624</xloc><yloc>272</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>per account</name>
    <type>GroupBy</type>
    <description>15k events collapse to one row per account, so "has this person ever failed to sign in" stops being a table scan.</description>
    <all_rows>N</all_rows>
    <ignore_aggregate>N</ignore_aggregate>
    <field_ignore/>
    <directory>${java.io.tmpdir}</directory>
    <prefix>grp</prefix>
    <add_linenr>N</add_linenr>
    <linenr_fieldname/>
    <give_back_row>N</give_back_row>
    <group>
      <field><name>account_id</name></field>
    </group>
    <fields>
      <field><aggregate>events</aggregate><subject>account_id</subject><type>COUNT_ALL</type><valuefield/></field>
      <field><aggregate>failures</aggregate><subject>failure</subject><type>SUM</type><valuefield/></field>
      <field><aggregate>first_seen</aggregate><subject>occurred_at</subject><type>MIN</type><valuefield/></field>
      <field><aggregate>last_seen</aggregate><subject>occurred_at</subject><type>MAX</type><valuefield/></field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>784</xloc><yloc>272</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>+ metaunit (summary)</name>
    <type>Constant</type>
    <description/>
    <fields>
      <field><name>metaunit</name><type>Integer</type><nullif>111</nullif><length>-1</length><precision>-1</precision><set_empty_string>N</set_empty_string></field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>944</xloc><yloc>272</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>pick summary columns</name>
    <type>SelectValues</type>
    <description/>
    <fields>
      <field><name>account_id</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>events</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>failures</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>first_seen</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>last_seen</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>metaunit</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <select_unspecified>N</select_unspecified>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>1088</xloc><yloc>272</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>→ auth_summary</name>
    <type>TableOutput</type>
    <description/>
    <connection>mariadb_target</connection>
    <schema/>
    <table>auth_summary</table>
    <commit>1000</commit>
    <truncate>N</truncate>
    <only_when_have_rows>N</only_when_have_rows>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <auto_update_table_structure>N</auto_update_table_structure>
    <always_drop_and_recreate>N</always_drop_and_recreate>
    <add_columns>N</add_columns>
    <drop_columns>N</drop_columns>
    <change_column_types>N</change_column_types>
    <fields>
      <field><stream_name>account_id</stream_name><column_name>account_id</column_name></field>
      <field><stream_name>events</stream_name><column_name>events</column_name></field>
      <field><stream_name>failures</stream_name><column_name>failures</column_name></field>
      <field><stream_name>first_seen</stream_name><column_name>first_seen</column_name></field>
      <field><stream_name>last_seen</stream_name><column_name>last_seen</column_name></field>
      <field><stream_name>metaunit</stream_name><column_name>metaunit</column_name></field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>1248</xloc><yloc>272</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>dates → Oslo</name>
    <type>SelectValues</type>
    <description>Source datetimes are UTC strings (their MS SQL box runs UTC). Declaring the timezone here makes them real instants; the MariaDB session is Europe/Oslo, so they land as Norwegian wall-clock and DST is the zone database&#x27;s problem, not ours.</description>
    <fields>
      <select_unspecified>N</select_unspecified>
      <meta><name>occurred_at</name><rename>occurred_at</rename><type>Timestamp</type><length>-2</length><precision>-2</precision><conversion_mask>yyyy-MM-dd HH:mm:ss</conversion_mask><date_format_lenient>false</date_format_lenient><date_format_locale/><date_format_timezone>UTC</date_format_timezone><lenient_string_to_number>false</lenient_string_to_number><encoding/><decimal_symbol/><grouping_symbol/><currency_symbol/><storage_type/></meta>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>200</xloc><yloc>160</yloc></GUI>
    <attributes/>
  </transform>
  <order>
    <hop><from>login_events (mssql)</from><to>dates → Oslo</to><enabled>Y</enabled></hop>
    <hop><from>dates → Oslo</from><to>+ metaunit</to><enabled>Y</enabled></hop>
    <hop><from>+ metaunit</from><to>pick target columns</to><enabled>Y</enabled></hop>
    <hop><from>pick target columns</from><to>→ auth_events</to><enabled>Y</enabled></hop>
    <hop><from>+ metaunit</from><to>failure flag</to><enabled>Y</enabled></hop>
    <hop><from>failure flag</from><to>sort by account</to><enabled>Y</enabled></hop>
    <hop><from>sort by account</from><to>per account</to><enabled>Y</enabled></hop>
    <hop><from>per account</from><to>+ metaunit (summary)</to><enabled>Y</enabled></hop>
    <hop><from>+ metaunit (summary)</from><to>pick summary columns</to><enabled>Y</enabled></hop>
    <hop><from>pick summary columns</from><to>→ auth_summary</to><enabled>Y</enabled></hop>
  </order>
  <notepads/>
  <attributes/>
  <transform_error_handling/>
</pipeline>
