<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>09-reviews</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>-1</pipeline_status>
    <parameters/>
    <description>reviews -&gt; reviews + quarantine. Filter rows splits the stream in two.</description>
  </info>
  <transform>
    <name>reviews (mssql)</name>
    <type>TableInput</type>
    <connection>mssql_source</connection>
    <sql>SELECT LOWER(SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;reviews:&#x27; + CAST(r.id AS VARCHAR(20))), 2),1,8) + &#x27;-&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;reviews:&#x27; + CAST(r.id AS VARCHAR(20))), 2),9,4) + &#x27;-3&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;reviews:&#x27; + CAST(r.id AS VARCHAR(20))), 2),14,3) + &#x27;-a&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;reviews:&#x27; + CAST(r.id AS VARCHAR(20))), 2),18,3) + &#x27;-&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;reviews:&#x27; + CAST(r.id AS VARCHAR(20))), 2),21,12)) AS id,
       LOWER(SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;products:&#x27; + CAST(r.product_id AS VARCHAR(20))), 2),1,8) + &#x27;-&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;products:&#x27; + CAST(r.product_id AS VARCHAR(20))), 2),9,4) + &#x27;-3&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;products:&#x27; + CAST(r.product_id AS VARCHAR(20))), 2),14,3) + &#x27;-a&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;products:&#x27; + CAST(r.product_id AS VARCHAR(20))), 2),18,3) + &#x27;-&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;products:&#x27; + CAST(r.product_id AS VARCHAR(20))), 2),21,12)) AS listing_id,
       LOWER(SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;account:&#x27; + LOWER(LTRIM(RTRIM(u.email)))), 2),1,8) + &#x27;-&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;account:&#x27; + LOWER(LTRIM(RTRIM(u.email)))), 2),9,4) + &#x27;-3&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;account:&#x27; + LOWER(LTRIM(RTRIM(u.email)))), 2),14,3) + &#x27;-a&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;account:&#x27; + LOWER(LTRIM(RTRIM(u.email)))), 2),18,3) + &#x27;-&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;account:&#x27; + LOWER(LTRIM(RTRIM(u.email)))), 2),21,12)) AS account_id,
       r.rating, r.title, r.body,
       CONVERT(VARCHAR(19), r.created_at, 120) AS created_at
FROM reviews r JOIN users u ON u.id = r.user_id</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lookup/>
    <sql_from_file/>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI><xloc>128</xloc><yloc>128</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>capitalise title</name>
    <type>StringOperations</type>
    <description>Their titles are whatever the buyer typed.</description>
    <fields>
      <field><in_stream_name>title</in_stream_name><out_stream_name></out_stream_name><trim_type>both</trim_type><lower_upper>none</lower_upper><padding_type>none</padding_type><pad_char/><pad_len/><init_cap>yes</init_cap><mask_xml>none</mask_xml><digits>none</digits><remove_special_characters>none</remove_special_characters></field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>272</xloc><yloc>128</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>+ metaunit</name>
    <type>Constant</type>
    <description/>
    <fields>
      <field><name>metaunit</name><type>Integer</type><nullif>111</nullif><length>-1</length><precision>-1</precision><set_empty_string>N</set_empty_string></field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>416</xloc><yloc>128</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>has a body?</name>
    <type>FilterRows</type>
    <description>A star rating with no words is not a review. It still migrates - to a table nobody reports on.</description>
    <send_true_to>pick target columns</send_true_to>
    <send_false_to>pick quarantine columns</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>body</leftvalue>
        <function>IS NOT NULL</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>String</type>
          <text></text>
          <length>-1</length>
          <precision>0</precision>
          <isnull>N</isnull>
          <mask/>
        </value>
      </condition>
    </compare>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>560</xloc><yloc>128</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>pick target columns</name>
    <type>SelectValues</type>
    <description/>
    <fields>
      <field><name>id</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>listing_id</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>account_id</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>rating</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>title</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>body</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>created_at</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>metaunit</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <select_unspecified>N</select_unspecified>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>736</xloc><yloc>64</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>→ reviews</name>
    <type>TableOutput</type>
    <description/>
    <connection>mariadb_target</connection>
    <schema/>
    <table>reviews</table>
    <commit>1000</commit>
    <truncate>N</truncate>
    <only_when_have_rows>N</only_when_have_rows>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <auto_update_table_structure>N</auto_update_table_structure>
    <always_drop_and_recreate>N</always_drop_and_recreate>
    <add_columns>N</add_columns>
    <drop_columns>N</drop_columns>
    <change_column_types>N</change_column_types>
    <fields>
      <field><stream_name>id</stream_name><column_name>id</column_name></field>
      <field><stream_name>listing_id</stream_name><column_name>listing_id</column_name></field>
      <field><stream_name>account_id</stream_name><column_name>account_id</column_name></field>
      <field><stream_name>rating</stream_name><column_name>rating</column_name></field>
      <field><stream_name>title</stream_name><column_name>title</column_name></field>
      <field><stream_name>body</stream_name><column_name>body</column_name></field>
      <field><stream_name>created_at</stream_name><column_name>created_at</column_name></field>
      <field><stream_name>metaunit</stream_name><column_name>metaunit</column_name></field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>896</xloc><yloc>64</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>pick quarantine columns</name>
    <type>SelectValues</type>
    <description/>
    <fields>
      <field><name>id</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>listing_id</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>account_id</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>rating</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>title</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>body</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>created_at</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>metaunit</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <select_unspecified>N</select_unspecified>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>736</xloc><yloc>208</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>→ reviews_quarantine</name>
    <type>TableOutput</type>
    <description/>
    <connection>mariadb_target</connection>
    <schema/>
    <table>reviews_quarantine</table>
    <commit>1000</commit>
    <truncate>N</truncate>
    <only_when_have_rows>N</only_when_have_rows>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <auto_update_table_structure>N</auto_update_table_structure>
    <always_drop_and_recreate>N</always_drop_and_recreate>
    <add_columns>N</add_columns>
    <drop_columns>N</drop_columns>
    <change_column_types>N</change_column_types>
    <fields>
      <field><stream_name>id</stream_name><column_name>id</column_name></field>
      <field><stream_name>listing_id</stream_name><column_name>listing_id</column_name></field>
      <field><stream_name>account_id</stream_name><column_name>account_id</column_name></field>
      <field><stream_name>rating</stream_name><column_name>rating</column_name></field>
      <field><stream_name>title</stream_name><column_name>title</column_name></field>
      <field><stream_name>body</stream_name><column_name>body</column_name></field>
      <field><stream_name>created_at</stream_name><column_name>created_at</column_name></field>
      <field><stream_name>metaunit</stream_name><column_name>metaunit</column_name></field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>896</xloc><yloc>208</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>dates → Oslo</name>
    <type>SelectValues</type>
    <description>Source datetimes are UTC strings (their MS SQL box runs UTC). Declaring the timezone here makes them real instants; the MariaDB session is Europe/Oslo, so they land as Norwegian wall-clock and DST is the zone database&#x27;s problem, not ours.</description>
    <fields>
      <select_unspecified>N</select_unspecified>
      <meta><name>created_at</name><rename>created_at</rename><type>Timestamp</type><length>-2</length><precision>-2</precision><conversion_mask>yyyy-MM-dd HH:mm:ss</conversion_mask><date_format_lenient>false</date_format_lenient><date_format_locale/><date_format_timezone>UTC</date_format_timezone><lenient_string_to_number>false</lenient_string_to_number><encoding/><decimal_symbol/><grouping_symbol/><currency_symbol/><storage_type/></meta>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>344</xloc><yloc>128</yloc></GUI>
    <attributes/>
  </transform>
  <order>
    <hop><from>reviews (mssql)</from><to>capitalise title</to><enabled>Y</enabled></hop>
    <hop><from>capitalise title</from><to>dates → Oslo</to><enabled>Y</enabled></hop>
    <hop><from>dates → Oslo</from><to>+ metaunit</to><enabled>Y</enabled></hop>
    <hop><from>+ metaunit</from><to>has a body?</to><enabled>Y</enabled></hop>
    <hop><from>has a body?</from><to>pick target columns</to><enabled>Y</enabled></hop>
    <hop><from>pick target columns</from><to>→ reviews</to><enabled>Y</enabled></hop>
    <hop><from>has a body?</from><to>pick quarantine columns</to><enabled>Y</enabled></hop>
    <hop><from>pick quarantine columns</from><to>→ reviews_quarantine</to><enabled>Y</enabled></hop>
  </order>
  <notepads/>
  <attributes/>
  <transform_error_handling/>
</pipeline>
