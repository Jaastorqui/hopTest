    <type>SelectValues</type>
    <description/>
    <fields>
      <field><name>mi_id</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>mi_rel_type</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>pd_id</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>or_type</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>or_status</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>or_payment_type</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>or_start_date</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>or_end_date</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>or_payment_frequency</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>or_renew</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>or_timestamp</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>un_id</name><rename></rename><length>-2</length><precision>-2</precision></field>
