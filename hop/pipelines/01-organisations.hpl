<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>01-organisations</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>-1</pipeline_status>
    <parameters/>
    <description>companies -&gt; organisations. Value mapper, string cleanup, constant, explicit column list.</description>
  </info>
  <transform>
    <name>companies (mssql)</name>
    <type>TableInput</type>
    <description>Still carries the old migration_map columns; the Select values transform drops them.</description>
    <connection>mssql_source</connection>
    <sql>SELECT LOWER(SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;companies:&#x27; + CAST(c.id AS VARCHAR(20))), 2),1,8) + &#x27;-&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;companies:&#x27; + CAST(c.id AS VARCHAR(20))), 2),9,4) + &#x27;-3&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;companies:&#x27; + CAST(c.id AS VARCHAR(20))), 2),14,3) + &#x27;-a&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;companies:&#x27; + CAST(c.id AS VARCHAR(20))), 2),18,3) + &#x27;-&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;companies:&#x27; + CAST(c.id AS VARCHAR(20))), 2),21,12)) AS id,
       c.org_number, c.country, c.name, c.slug,
       (SELECT c.email AS email, c.phone AS phone
        FOR JSON PATH, WITHOUT_ARRAY_WRAPPER) AS contact,
       (SELECT c.address_line1 AS line1, c.address_line2 AS line2,
               c.postal_code AS postal_code, c.city AS city, c.country AS country
        FOR JSON PATH, WITHOUT_ARRAY_WRAPPER) AS address,
       c.status, c.commission_rate,
       CONVERT(VARCHAR(19), c.created_at, 120) AS created_at,
       &#x27;companies&#x27; AS source_table, CAST(c.id AS VARCHAR(40)) AS source_id,
       &#x27;organisations&#x27; AS target_table, LOWER(SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;companies:&#x27; + CAST(c.id AS VARCHAR(20))), 2),1,8) + &#x27;-&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;companies:&#x27; + CAST(c.id AS VARCHAR(20))), 2),9,4) + &#x27;-3&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;companies:&#x27; + CAST(c.id AS VARCHAR(20))), 2),14,3) + &#x27;-a&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;companies:&#x27; + CAST(c.id AS VARCHAR(20))), 2),18,3) + &#x27;-&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;companies:&#x27; + CAST(c.id AS VARCHAR(20))), 2),21,12)) AS target_id,
       &#x27;derived uuid&#x27; AS note
FROM companies c</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lookup/>
    <sql_from_file/>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI><xloc>128</xloc><yloc>96</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>status label</name>
    <type>ValueMapper</type>
    <description>Their four status codes are ours too, but nothing in their DB says what they mean to a human.</description>
    <field_to_use>status</field_to_use>
    <target_field>status_label</target_field>
    <non_match_default>Unknown</non_match_default>
    <fields>
      <field><source_value>pending</source_value><target_value>Awaiting approval</target_value></field>
      <field><source_value>active</source_value><target_value>Active seller</target_value></field>
      <field><source_value>suspended</source_value><target_value>Suspended - payouts held</target_value></field>
      <field><source_value>closed</source_value><target_value>Closed</target_value></field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>288</xloc><yloc>96</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>tidy slug + name</name>
    <type>StringOperations</type>
    <description>Source slugs arrive with stray whitespace and mixed case; uq_org_slug would let both through.</description>
    <fields>
      <field><in_stream_name>slug</in_stream_name><out_stream_name></out_stream_name><trim_type>both</trim_type><lower_upper>lower</lower_upper><padding_type>none</padding_type><pad_char/><pad_len/><init_cap>no</init_cap><mask_xml>none</mask_xml><digits>none</digits><remove_special_characters>none</remove_special_characters></field>
      <field><in_stream_name>name</in_stream_name><out_stream_name></out_stream_name><trim_type>both</trim_type><lower_upper>none</lower_upper><padding_type>none</padding_type><pad_char/><pad_len/><init_cap>no</init_cap><mask_xml>none</mask_xml><digits>none</digits><remove_special_characters>none</remove_special_characters></field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>432</xloc><yloc>96</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>+ metaunit</name>
    <type>Constant</type>
    <description>Constant stamped on every target row.</description>
    <fields>
      <field><name>metaunit</name><type>Integer</type><nullif>111</nullif><length>-1</length><precision>-1</precision><set_empty_string>N</set_empty_string></field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>576</xloc><yloc>96</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>pick target columns</name>
    <type>SelectValues</type>
    <description>Explicit list. Anything else the query carries is dropped here, not silently.</description>
    <fields>
      <field><name>id</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>org_number</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>country</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>name</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>slug</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>contact</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>address</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>status</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>status_label</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>commission_rate</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>created_at</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>metaunit</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <select_unspecified>N</select_unspecified>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>720</xloc><yloc>96</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>→ organisations</name>
    <type>TableOutput</type>
    <description/>
    <connection>mariadb_target</connection>
    <schema/>
    <table>organisations</table>
    <commit>1000</commit>
    <truncate>N</truncate>
    <only_when_have_rows>N</only_when_have_rows>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <auto_update_table_structure>N</auto_update_table_structure>
    <always_drop_and_recreate>N</always_drop_and_recreate>
    <add_columns>N</add_columns>
    <drop_columns>N</drop_columns>
    <change_column_types>N</change_column_types>
    <fields>
      <field><stream_name>id</stream_name><column_name>id</column_name></field>
      <field><stream_name>org_number</stream_name><column_name>org_number</column_name></field>
      <field><stream_name>country</stream_name><column_name>country</column_name></field>
      <field><stream_name>name</stream_name><column_name>name</column_name></field>
      <field><stream_name>slug</stream_name><column_name>slug</column_name></field>
      <field><stream_name>contact</stream_name><column_name>contact</column_name></field>
      <field><stream_name>address</stream_name><column_name>address</column_name></field>
      <field><stream_name>status</stream_name><column_name>status</column_name></field>
      <field><stream_name>status_label</stream_name><column_name>status_label</column_name></field>
      <field><stream_name>commission_rate</stream_name><column_name>commission_rate</column_name></field>
      <field><stream_name>created_at</stream_name><column_name>created_at</column_name></field>
      <field><stream_name>metaunit</stream_name><column_name>metaunit</column_name></field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>880</xloc><yloc>96</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>dates → Oslo</name>
    <type>SelectValues</type>
    <description>Source datetimes are UTC strings (their MS SQL box runs UTC). Declaring the timezone here makes them real instants; the MariaDB session is Europe/Oslo, so they land as Norwegian wall-clock and DST is the zone database&#x27;s problem, not ours.</description>
    <fields>
      <select_unspecified>N</select_unspecified>
      <meta><name>created_at</name><rename>created_at</rename><type>Timestamp</type><length>-2</length><precision>-2</precision><conversion_mask>yyyy-MM-dd HH:mm:ss</conversion_mask><date_format_lenient>false</date_format_lenient><date_format_locale/><date_format_timezone>UTC</date_format_timezone><lenient_string_to_number>false</lenient_string_to_number><encoding/><decimal_symbol/><grouping_symbol/><currency_symbol/><storage_type/></meta>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>648</xloc><yloc>96</yloc></GUI>
    <attributes/>
  </transform>
  <order>
    <hop><from>companies (mssql)</from><to>status label</to><enabled>Y</enabled></hop>
    <hop><from>status label</from><to>tidy slug + name</to><enabled>Y</enabled></hop>
    <hop><from>tidy slug + name</from><to>dates → Oslo</to><enabled>Y</enabled></hop>
    <hop><from>dates → Oslo</from><to>+ metaunit</to><enabled>Y</enabled></hop>
    <hop><from>+ metaunit</from><to>pick target columns</to><enabled>Y</enabled></hop>
    <hop><from>pick target columns</from><to>→ organisations</to><enabled>Y</enabled></hop>
  </order>
  <notepads/>
  <attributes/>
  <transform_error_handling/>
</pipeline>
