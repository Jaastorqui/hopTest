<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>04-memberships</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>-1</pipeline_status>
    <parameters/>
    <description>company_users.role -&gt; memberships. Database lookup validates 02 as a side effect.</description>
  </info>
  <transform>
    <name>company_users (mssql)</name>
    <type>TableInput</type>
    <connection>mssql_source</connection>
    <sql>WITH m AS (
    SELECT LOWER(SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;account:&#x27; + LOWER(LTRIM(RTRIM(cu.email)))), 2),1,8) + &#x27;-&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;account:&#x27; + LOWER(LTRIM(RTRIM(cu.email)))), 2),9,4) + &#x27;-3&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;account:&#x27; + LOWER(LTRIM(RTRIM(cu.email)))), 2),14,3) + &#x27;-a&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;account:&#x27; + LOWER(LTRIM(RTRIM(cu.email)))), 2),18,3) + &#x27;-&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;account:&#x27; + LOWER(LTRIM(RTRIM(cu.email)))), 2),21,12)) AS account_id,
           LOWER(SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;companies:&#x27; + CAST(cu.company_id AS VARCHAR(20))), 2),1,8) + &#x27;-&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;companies:&#x27; + CAST(cu.company_id AS VARCHAR(20))), 2),9,4) + &#x27;-3&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;companies:&#x27; + CAST(cu.company_id AS VARCHAR(20))), 2),14,3) + &#x27;-a&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;companies:&#x27; + CAST(cu.company_id AS VARCHAR(20))), 2),18,3) + &#x27;-&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;companies:&#x27; + CAST(cu.company_id AS VARCHAR(20))), 2),21,12)) AS organisation_id,
           cu.role, cu.is_active,
           CONVERT(VARCHAR(19), cu.created_at, 120) AS created_at,
           ROW_NUMBER() OVER (PARTITION BY LOWER(LTRIM(RTRIM(cu.email))), cu.company_id
                              ORDER BY cu.id) AS rn
    FROM company_users cu
)
SELECT account_id, organisation_id, role, is_active, created_at
FROM m WHERE rn = 1</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lookup/>
    <sql_from_file/>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI><xloc>112</xloc><yloc>96</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>account email</name>
    <type>DBLookup</type>
    <description>Reads back the accounts 02 just wrote. Both sides derive the same uuid from the same email, so a miss here means 02 dropped somebody - the lookup is the assertion.</description>
    <connection>mariadb_target</connection>
    <cache>Y</cache>
    <cache_load_all>Y</cache_load_all>
    <cache_size>0</cache_size>
    <lookup>
      <schema/>
      <table>accounts</table>
      <orderby/>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
      <key><name>account_id</name><field>id</field><condition>=</condition><name2/></key>
      <value><name>email</name><rename>account_email</rename><default></default><type>String</type></value>
    </lookup>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>288</xloc><yloc>96</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>+ metaunit</name>
    <type>Constant</type>
    <description/>
    <fields>
      <field><name>metaunit</name><type>Integer</type><nullif>111</nullif><length>-1</length><precision>-1</precision><set_empty_string>N</set_empty_string></field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>464</xloc><yloc>96</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>pick target columns</name>
    <type>SelectValues</type>
    <description/>
    <fields>
      <field><name>account_id</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>organisation_id</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>role</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>account_email</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>is_active</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>created_at</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>metaunit</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <select_unspecified>N</select_unspecified>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>624</xloc><yloc>96</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>→ memberships</name>
    <type>TableOutput</type>
    <description/>
    <connection>mariadb_target</connection>
    <schema/>
    <table>memberships</table>
    <commit>1000</commit>
    <truncate>N</truncate>
    <only_when_have_rows>N</only_when_have_rows>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <auto_update_table_structure>N</auto_update_table_structure>
    <always_drop_and_recreate>N</always_drop_and_recreate>
    <add_columns>N</add_columns>
    <drop_columns>N</drop_columns>
    <change_column_types>N</change_column_types>
    <fields>
      <field><stream_name>account_id</stream_name><column_name>account_id</column_name></field>
      <field><stream_name>organisation_id</stream_name><column_name>organisation_id</column_name></field>
      <field><stream_name>role</stream_name><column_name>role</column_name></field>
      <field><stream_name>account_email</stream_name><column_name>account_email</column_name></field>
      <field><stream_name>is_active</stream_name><column_name>is_active</column_name></field>
      <field><stream_name>created_at</stream_name><column_name>created_at</column_name></field>
      <field><stream_name>metaunit</stream_name><column_name>metaunit</column_name></field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>784</xloc><yloc>96</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>dates → Oslo</name>
    <type>SelectValues</type>
    <description>Source datetimes are UTC strings (their MS SQL box runs UTC). Declaring the timezone here makes them real instants; the MariaDB session is Europe/Oslo, so they land as Norwegian wall-clock and DST is the zone database&#x27;s problem, not ours.</description>
    <fields>
      <select_unspecified>N</select_unspecified>
      <meta><name>created_at</name><rename>created_at</rename><type>Timestamp</type><length>-2</length><precision>-2</precision><conversion_mask>yyyy-MM-dd HH:mm:ss</conversion_mask><date_format_lenient>false</date_format_lenient><date_format_locale/><date_format_timezone>UTC</date_format_timezone><lenient_string_to_number>false</lenient_string_to_number><encoding/><decimal_symbol/><grouping_symbol/><currency_symbol/><storage_type/></meta>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>376</xloc><yloc>96</yloc></GUI>
    <attributes/>
  </transform>
  <order>
    <hop><from>company_users (mssql)</from><to>account email</to><enabled>Y</enabled></hop>
    <hop><from>account email</from><to>dates → Oslo</to><enabled>Y</enabled></hop>
    <hop><from>dates → Oslo</from><to>+ metaunit</to><enabled>Y</enabled></hop>
    <hop><from>+ metaunit</from><to>pick target columns</to><enabled>Y</enabled></hop>
    <hop><from>pick target columns</from><to>→ memberships</to><enabled>Y</enabled></hop>
  </order>
  <notepads/>
  <attributes/>
  <transform_error_handling/>
</pipeline>
