<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>05-categories</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>-1</pipeline_status>
    <parameters/>
    <description>parent_id -&gt; materialised path. Field splitter, coalesce, calculator.</description>
  </info>
  <transform>
    <name>categories (mssql)</name>
    <type>TableInput</type>
    <description>Recursive CTE flattens parent_id into a path.</description>
    <connection>mssql_source</connection>
    <sql>WITH tree AS (
    SELECT c.id, c.parent_id, c.name, CAST(c.slug AS VARCHAR(255)) AS path, 0 AS depth
    FROM categories c WHERE c.parent_id IS NULL
    UNION ALL
    SELECT c.id, c.parent_id, c.name, CAST(t.path + &#x27;/&#x27; + c.slug AS VARCHAR(255)), t.depth + 1
    FROM categories c JOIN tree t ON t.id = c.parent_id
)
SELECT LOWER(SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;categories:&#x27; + CAST(id AS VARCHAR(20))), 2),1,8) + &#x27;-&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;categories:&#x27; + CAST(id AS VARCHAR(20))), 2),9,4) + &#x27;-3&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;categories:&#x27; + CAST(id AS VARCHAR(20))), 2),14,3) + &#x27;-a&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;categories:&#x27; + CAST(id AS VARCHAR(20))), 2),18,3) + &#x27;-&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;categories:&#x27; + CAST(id AS VARCHAR(20))), 2),21,12)) AS id, path, path AS path_parts, name, depth,
       CONVERT(VARCHAR(19), GETUTCDATE(), 120) AS created_at
FROM tree</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lookup/>
    <sql_from_file/>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI><xloc>112</xloc><yloc>96</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>split path</name>
    <type>FieldSplitter</type>
    <description>verktoy/handverktoy/hammer -&gt; three columns. Shallow rows leave the tail empty.</description>
    <splitfield>path_parts</splitfield>
    <delimiter>/</delimiter>
    <enclosure/>
    <escape_string/>
    <fields>
      <field><name>root_slug</name><id/><idrem>N</idrem><type>String</type><format/><group/><decimal/><currency/><length>-1</length><precision>-1</precision><nullif/><ifnull/><trimtype>none</trimtype></field>
      <field><name>sub_slug</name><id/><idrem>N</idrem><type>String</type><format/><group/><decimal/><currency/><length>-1</length><precision>-1</precision><nullif/><ifnull/><trimtype>none</trimtype></field>
      <field><name>third_slug</name><id/><idrem>N</idrem><type>String</type><format/><group/><decimal/><currency/><length>-1</length><precision>-1</precision><nullif/><ifnull/><trimtype>none</trimtype></field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>368</xloc><yloc>96</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>leaf slug</name>
    <type>Coalesce</type>
    <description>First non-empty from the deepest end: the leaf of a path of unknown length.</description>
    <fields>
      <field><input>third_slug, sub_slug, root_slug</input><name>leaf_slug</name><remove>N</remove><type>String</type></field>
    </fields>
    <empty_is_null>Y</empty_is_null>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>496</xloc><yloc>96</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>level</name>
    <type>Calculator</type>
    <description>depth is 0-based from the CTE; the UI counts from 1.</description>
    <calculation><calc_type>CONSTANT</calc_type><field_a>1</field_a><field_name>one</field_name><remove>Y</remove><value_length>-1</value_length><value_precision>-1</value_precision><value_type>Integer</value_type></calculation>
    <calculation><calc_type>ADD</calc_type><field_a>depth</field_a><field_b>one</field_b><field_name>level</field_name><remove>N</remove><value_length>-1</value_length><value_precision>-1</value_precision><value_type>Integer</value_type></calculation>
    <failIfNoFile>Y</failIfNoFile>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>624</xloc><yloc>96</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>+ metaunit</name>
    <type>Constant</type>
    <description/>
    <fields>
      <field><name>metaunit</name><type>Integer</type><nullif>111</nullif><length>-1</length><precision>-1</precision><set_empty_string>N</set_empty_string></field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>752</xloc><yloc>96</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>pick target columns</name>
    <type>SelectValues</type>
    <description/>
    <fields>
      <field><name>id</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>path</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>root_slug</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>leaf_slug</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>name</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>depth</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>level</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>created_at</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>metaunit</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <select_unspecified>N</select_unspecified>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>880</xloc><yloc>96</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>→ categories</name>
    <type>TableOutput</type>
    <description/>
    <connection>mariadb_target</connection>
    <schema/>
    <table>categories</table>
    <commit>1000</commit>
    <truncate>N</truncate>
    <only_when_have_rows>N</only_when_have_rows>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <auto_update_table_structure>N</auto_update_table_structure>
    <always_drop_and_recreate>N</always_drop_and_recreate>
    <add_columns>N</add_columns>
    <drop_columns>N</drop_columns>
    <change_column_types>N</change_column_types>
    <fields>
      <field><stream_name>id</stream_name><column_name>id</column_name></field>
      <field><stream_name>path</stream_name><column_name>path</column_name></field>
      <field><stream_name>root_slug</stream_name><column_name>root_slug</column_name></field>
      <field><stream_name>leaf_slug</stream_name><column_name>leaf_slug</column_name></field>
      <field><stream_name>name</stream_name><column_name>name</column_name></field>
      <field><stream_name>depth</stream_name><column_name>depth</column_name></field>
      <field><stream_name>level</stream_name><column_name>level</column_name></field>
      <field><stream_name>created_at</stream_name><column_name>created_at</column_name></field>
      <field><stream_name>metaunit</stream_name><column_name>metaunit</column_name></field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>1024</xloc><yloc>96</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>dates → Oslo</name>
    <type>SelectValues</type>
    <description>Their categories table has no date at all. GETUTCDATE() in the query stamps the run, and it goes through the same UTC -&gt; Europe/Oslo conversion as every other date in the migration.</description>
    <fields>
      <select_unspecified>N</select_unspecified>
      <meta><name>created_at</name><rename>created_at</rename><type>Timestamp</type><length>-2</length><precision>-2</precision><conversion_mask>yyyy-MM-dd HH:mm:ss</conversion_mask><date_format_lenient>false</date_format_lenient><date_format_locale/><date_format_timezone>UTC</date_format_timezone><lenient_string_to_number>false</lenient_string_to_number><encoding/><decimal_symbol/><grouping_symbol/><currency_symbol/><storage_type/></meta>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>816</xloc><yloc>96</yloc></GUI>
    <attributes/>
  </transform>
  <order>
    <hop><from>categories (mssql)</from><to>split path</to><enabled>Y</enabled></hop>
    <hop><from>split path</from><to>leaf slug</to><enabled>Y</enabled></hop>
    <hop><from>leaf slug</from><to>level</to><enabled>Y</enabled></hop>
    <hop><from>level</from><to>dates → Oslo</to><enabled>Y</enabled></hop>
    <hop><from>dates → Oslo</from><to>+ metaunit</to><enabled>Y</enabled></hop>
    <hop><from>+ metaunit</from><to>pick target columns</to><enabled>Y</enabled></hop>
    <hop><from>pick target columns</from><to>→ categories</to><enabled>Y</enabled></hop>
  </order>
  <notepads/>
  <attributes/>
  <transform_error_handling/>
</pipeline>
