<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>06-order-lines</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>-1</pipeline_status>
    <parameters/>
    <description>Their order_items -&gt; econ_order_line. Parent and product both found by natural key.</description>
  </info>
  <transform>
    <name>order_items (mssql)</name>
    <type>TableInput</type>
    <connection>mssql_source</connection>
    <sql>-- Re-reading the origin for BOTH natural keys: (org_nr, placed_at) finds the parent
-- econ_order, and company+sku finds the econ_product. No id from their system is used
-- as a key here - only values both systems independently know.
SELECT LTRIM(RTRIM(c.org_number))     AS co_org_nr,
       DATEDIFF(SECOND, &#x27;1970-01-01&#x27;, o.placed_at)      AS or_timestamp,
       LOWER(CONCAT(CAST(oi.company_id AS VARCHAR(10)), &#x27;-&#x27;, p.sku)) AS pr_slug,
       p.name                         AS ol_name,
       p.description                  AS ol_description,
       CAST(oi.unit_price AS DECIMAL(10,2))               AS ol_basic_price,
       CAST(oi.unit_price * oi.quantity AS DECIMAL(10,2)) AS ol_price,
       oi.quantity                    AS ol_total_quantity,
       DATEDIFF(SECOND, &#x27;1970-01-01&#x27;, o.placed_at)      AS ol_start_date,
       DATEDIFF(SECOND, &#x27;1970-01-01&#x27;, DATEADD(YEAR, 1, o.placed_at)) AS ol_end_date,
       DATEDIFF(SECOND, &#x27;1970-01-01&#x27;, o.placed_at)      AS metaregtime
FROM order_items oi
JOIN products p ON p.id = oi.product_id
JOIN orders   o ON o.id = oi.order_id
CROSS APPLY (SELECT TOP 1 company_id FROM order_items x WHERE x.order_id = o.id ORDER BY x.id) owner
JOIN companies c ON c.id = owner.company_id</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lookup/>
    <sql_from_file/>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI><xloc>112</xloc><yloc>160</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>master id by org nr</name>
    <type>DBLookup</type>
    <description/>
    <connection>mariadb_target</connection>
    <cache>Y</cache>
    <cache_load_all>Y</cache_load_all>
    <cache_size>0</cache_size>
    <lookup>
      <schema/>
      <table>customer_master_id_lookup</table>
      <orderby/>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
      <key><name>co_org_nr</name><field>mi_org_nr</field><condition>=</condition><name2/></key>
      <value><name>mi_id</name><rename>mi_id</rename><default>0</default><type>Integer</type></value>
    </lookup>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>272</xloc><yloc>160</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>parent order</name>
    <type>DBLookup</type>
    <description>Two-column natural key, because econ_order carries nothing of theirs to match on. Verified unique in the source before relying on it - 8000 orders, 8000 distinct (company, placed_at) pairs.</description>
    <connection>mariadb_target</connection>
    <cache>Y</cache>
    <cache_load_all>Y</cache_load_all>
    <cache_size>0</cache_size>
    <lookup>
      <schema/>
      <table>econ_order</table>
      <orderby/>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
      <key><name>mi_id</name><field>mi_id</field><condition>=</condition><name2/></key>
      <key><name>or_timestamp</name><field>or_timestamp</field><condition>=</condition><name2/></key>
      <value><name>or_id</name><rename>or_id</rename><default>0</default><type>Integer</type></value>
    </lookup>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>432</xloc><yloc>160</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>product id by slug</name>
    <type>DBLookup</type>
    <description>company+sku, the natural key 04 wrote into pr_slug.</description>
    <connection>mariadb_target</connection>
    <cache>Y</cache>
    <cache_load_all>Y</cache_load_all>
    <cache_size>0</cache_size>
    <lookup>
      <schema/>
      <table>econ_product</table>
      <orderby/>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
      <key><name>pr_slug</name><field>pr_slug</field><condition>=</condition><name2/></key>
      <value><name>pr_id</name><rename>pr_id</rename><default>0</default><type>Integer</type></value>
    </lookup>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>592</xloc><yloc>160</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>melvis defaults</name>
    <type>Calculator</type>
    <description/>
    <calculation><calc_type>CONSTANT</calc_type><field_a>0</field_a><field_name>tp_id</field_name><remove>N</remove><value_length>-1</value_length><value_precision>-1</value_precision><value_type>Integer</value_type></calculation>
    <calculation><calc_type>CONSTANT</calc_type><field_a>0.00</field_a><field_name>ol_discount_amount</field_name><remove>N</remove><value_length>-1</value_length><value_precision>-1</value_precision><value_type>Number</value_type></calculation>
    <calculation><calc_type>CONSTANT</calc_type><field_a>0.00</field_a><field_name>ol_discount_percent</field_name><remove>N</remove><value_length>-1</value_length><value_precision>-1</value_precision><value_type>Number</value_type></calculation>
    <calculation><calc_type>CONSTANT</calc_type><field_a>1</field_a><field_name>ol_discount_type</field_name><remove>N</remove><value_length>-1</value_length><value_precision>-1</value_precision><value_type>Integer</value_type></calculation>
    <calculation><calc_type>CONSTANT</calc_type><field_a>25.00</field_a><field_name>ol_vat</field_name><remove>N</remove><value_length>-1</value_length><value_precision>-1</value_precision><value_type>Number</value_type></calculation>
    <calculation><calc_type>CONSTANT</calc_type><field_a>1</field_a><field_name>ol_unit</field_name><remove>N</remove><value_length>-1</value_length><value_precision>-1</value_precision><value_type>Integer</value_type></calculation>
    <calculation><calc_type>CONSTANT</calc_type><field_a>1</field_a><field_name>ol_unit_value</field_name><remove>N</remove><value_length>-1</value_length><value_precision>-1</value_precision><value_type>Integer</value_type></calculation>
    <calculation><calc_type>CONSTANT</calc_type><field_a>0</field_a><field_name>ol_refresh_frequency</field_name><remove>N</remove><value_length>-1</value_length><value_precision>-1</value_precision><value_type>Integer</value_type></calculation>
    <calculation><calc_type>CONSTANT</calc_type><field_a>0</field_a><field_name>ol_refresh_interval</field_name><remove>N</remove><value_length>-1</value_length><value_precision>-1</value_precision><value_type>Integer</value_type></calculation>
    <calculation><calc_type>CONSTANT</calc_type><field_a>0</field_a><field_name>ol_renew</field_name><remove>N</remove><value_length>-1</value_length><value_precision>-1</value_precision><value_type>Integer</value_type></calculation>
    <calculation><calc_type>CONSTANT</calc_type><field_a>0</field_a><field_name>ol_renew_order</field_name><remove>N</remove><value_length>-1</value_length><value_precision>-1</value_precision><value_type>Integer</value_type></calculation>
    <calculation><calc_type>CONSTANT</calc_type><field_a>0</field_a><field_name>dc_id</field_name><remove>N</remove><value_length>-1</value_length><value_precision>-1</value_precision><value_type>Integer</value_type></calculation>
    <calculation><calc_type>CONSTANT</calc_type><field_a>1</field_a><field_name>ol_version</field_name><remove>N</remove><value_length>-1</value_length><value_precision>-1</value_precision><value_type>Integer</value_type></calculation>
    <calculation><calc_type>CONSTANT</calc_type><field_a>1</field_a><field_name>metaunit</field_name><remove>N</remove><value_length>-1</value_length><value_precision>-1</value_precision><value_type>Integer</value_type></calculation>
    <calculation><calc_type>CONSTANT</calc_type><field_a>0</field_a><field_name>source_id</field_name><remove>N</remove><value_length>-1</value_length><value_precision>-1</value_precision><value_type>Integer</value_type></calculation>
    <failIfNoFile>Y</failIfNoFile>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
