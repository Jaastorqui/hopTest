    <hop><from>product id by slug</from><to>melvis defaults</to><enabled>Y</enabled></hop>
    <hop><from>melvis defaults</from><to>empty strings</to><enabled>Y</enabled></hop>
    <hop><from>empty strings</from><to>parent and product found?</to><enabled>Y</enabled></hop>
    <hop><from>parent and product found?</from><to>product resolved?</to><enabled>Y</enabled></hop>
    <hop><from>product resolved?</from><to>pick target columns</to><enabled>Y</enabled></hop>
    <hop><from>pick target columns</from><to>→ econ_order_line</to><enabled>Y</enabled></hop>
    <hop><from>parent and product found?</from><to>orphan line</to><enabled>Y</enabled></hop>
    <hop><from>product resolved?</from><to>orphan line</to><enabled>Y</enabled></hop>
    <hop><from>orphan line</from><to>pick reject columns</to><enabled>Y</enabled></hop>
    <hop><from>pick reject columns</from><to>→ _migration_rejected </to><enabled>Y</enabled></hop>
  </order>
  <notepads/>
  <attributes/>
  <transform_error_handling/>
</pipeline>
