<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>03-logins</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>-1</pipeline_status>
    <parameters/>
    <description>Both identity tables -&gt; logins. Append + sort + unique rows, with the duplicate count kept.</description>
  </info>
  <transform>
    <name>users (mssql)</name>
    <type>TableInput</type>
    <connection>mssql_source</connection>
    <sql>SELECT LOWER(SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;login:&#x27; + LOWER(LTRIM(RTRIM(u.email)))), 2),1,8) + &#x27;-&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;login:&#x27; + LOWER(LTRIM(RTRIM(u.email)))), 2),9,4) + &#x27;-3&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;login:&#x27; + LOWER(LTRIM(RTRIM(u.email)))), 2),14,3) + &#x27;-a&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;login:&#x27; + LOWER(LTRIM(RTRIM(u.email)))), 2),18,3) + &#x27;-&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;login:&#x27; + LOWER(LTRIM(RTRIM(u.email)))), 2),21,12)) AS id,
       LOWER(SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;account:&#x27; + LOWER(LTRIM(RTRIM(u.email)))), 2),1,8) + &#x27;-&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;account:&#x27; + LOWER(LTRIM(RTRIM(u.email)))), 2),9,4) + &#x27;-3&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;account:&#x27; + LOWER(LTRIM(RTRIM(u.email)))), 2),14,3) + &#x27;-a&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;account:&#x27; + LOWER(LTRIM(RTRIM(u.email)))), 2),18,3) + &#x27;-&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;account:&#x27; + LOWER(LTRIM(RTRIM(u.email)))), 2),21,12)) AS account_id,
       &#x27;password&#x27; AS provider, LOWER(LTRIM(RTRIM(u.email))) AS identifier,
       u.password_hash AS secret_hash, u.is_active AS is_active,
       CONVERT(VARCHAR(19), u.last_login_at, 120) AS last_used_at,
       CONVERT(VARCHAR(19), u.created_at, 120) AS created_at
FROM users u</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lookup/>
    <sql_from_file/>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI><xloc>112</xloc><yloc>64</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>company_users (mssql)</name>
    <type>TableInput</type>
    <connection>mssql_source</connection>
    <sql>SELECT LOWER(SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;login:&#x27; + LOWER(LTRIM(RTRIM(cu.email)))), 2),1,8) + &#x27;-&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;login:&#x27; + LOWER(LTRIM(RTRIM(cu.email)))), 2),9,4) + &#x27;-3&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;login:&#x27; + LOWER(LTRIM(RTRIM(cu.email)))), 2),14,3) + &#x27;-a&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;login:&#x27; + LOWER(LTRIM(RTRIM(cu.email)))), 2),18,3) + &#x27;-&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;login:&#x27; + LOWER(LTRIM(RTRIM(cu.email)))), 2),21,12)) AS id,
       LOWER(SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;account:&#x27; + LOWER(LTRIM(RTRIM(cu.email)))), 2),1,8) + &#x27;-&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;account:&#x27; + LOWER(LTRIM(RTRIM(cu.email)))), 2),9,4) + &#x27;-3&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;account:&#x27; + LOWER(LTRIM(RTRIM(cu.email)))), 2),14,3) + &#x27;-a&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;account:&#x27; + LOWER(LTRIM(RTRIM(cu.email)))), 2),18,3) + &#x27;-&#x27; + SUBSTRING(CONVERT(CHAR(32), HASHBYTES(&#x27;MD5&#x27;, &#x27;account:&#x27; + LOWER(LTRIM(RTRIM(cu.email)))), 2),21,12)) AS account_id,
       &#x27;password&#x27; AS provider, LOWER(LTRIM(RTRIM(cu.email))) AS identifier,
       cu.password_hash AS secret_hash, cu.is_active AS is_active,
       CONVERT(VARCHAR(19), cu.last_login_at, 120) AS last_used_at,
       CONVERT(VARCHAR(19), cu.created_at, 120) AS created_at
FROM company_users cu</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lookup/>
    <sql_from_file/>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI><xloc>112</xloc><yloc>240</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>stack both streams</name>
    <type>Append</type>
    <description>Same shape on both legs, so append instead of join: 3625 rows in, duplicates and all.</description>
    <head_name>users (mssql)</head_name>
    <tail_name>company_users (mssql)</tail_name>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>288</xloc><yloc>152</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>sort by identifier</name>
    <type>SortRows</type>
    <description>Unique rows only removes ADJACENT duplicates. Without this sort it silently keeps them.</description>
    <directory>${java.io.tmpdir}</directory>
    <prefix>srt</prefix>
    <sort_size>100000</sort_size>
    <free_memory/>
    <compress>N</compress>
    <compress_variable/>
    <unique_rows>N</unique_rows>
    <fields>
      <field><name>identifier</name><ascending>Y</ascending><case_sensitive>N</case_sensitive><collator_enabled>N</collator_enabled><collator_strength>0</collator_strength><presorted>N</presorted></field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>432</xloc><yloc>152</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>one login per identifier</name>
    <type>Unique</type>
    <description>Keeps the first row of each group and counts the group. source_rows = 2 marks the 60 humans who had a password in both of their tables - we keep the buyer one.</description>
    <count_rows>Y</count_rows>
    <count_field>source_rows</count_field>
    <reject_duplicate_row>N</reject_duplicate_row>
    <error_description/>
    <fields>
      <field><name>identifier</name><case_insensitive>Y</case_insensitive></field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>576</xloc><yloc>152</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>+ metaunit</name>
    <type>Constant</type>
    <description/>
    <fields>
      <field><name>metaunit</name><type>Integer</type><nullif>111</nullif><length>-1</length><precision>-1</precision><set_empty_string>N</set_empty_string></field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>720</xloc><yloc>152</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>pick target columns</name>
    <type>SelectValues</type>
    <description/>
    <fields>
      <field><name>id</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>account_id</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>provider</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>identifier</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>secret_hash</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>is_active</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>source_rows</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>last_used_at</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>created_at</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>metaunit</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <select_unspecified>N</select_unspecified>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>864</xloc><yloc>152</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>→ logins</name>
    <type>TableOutput</type>
    <description/>
    <connection>mariadb_target</connection>
    <schema/>
    <table>logins</table>
    <commit>1000</commit>
    <truncate>N</truncate>
    <only_when_have_rows>N</only_when_have_rows>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <auto_update_table_structure>N</auto_update_table_structure>
    <always_drop_and_recreate>N</always_drop_and_recreate>
    <add_columns>N</add_columns>
    <drop_columns>N</drop_columns>
    <change_column_types>N</change_column_types>
    <fields>
      <field><stream_name>id</stream_name><column_name>id</column_name></field>
      <field><stream_name>account_id</stream_name><column_name>account_id</column_name></field>
      <field><stream_name>provider</stream_name><column_name>provider</column_name></field>
      <field><stream_name>identifier</stream_name><column_name>identifier</column_name></field>
      <field><stream_name>secret_hash</stream_name><column_name>secret_hash</column_name></field>
      <field><stream_name>is_active</stream_name><column_name>is_active</column_name></field>
      <field><stream_name>source_rows</stream_name><column_name>source_rows</column_name></field>
      <field><stream_name>last_used_at</stream_name><column_name>last_used_at</column_name></field>
      <field><stream_name>created_at</stream_name><column_name>created_at</column_name></field>
      <field><stream_name>metaunit</stream_name><column_name>metaunit</column_name></field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>1008</xloc><yloc>152</yloc></GUI>
    <attributes/>
  </transform>
  <transform>
    <name>dates → Oslo</name>
    <type>SelectValues</type>
    <description>Source datetimes are UTC strings (their MS SQL box runs UTC). Declaring the timezone here makes them real instants; the MariaDB session is Europe/Oslo, so they land as Norwegian wall-clock and DST is the zone database&#x27;s problem, not ours.</description>
    <fields>
      <select_unspecified>N</select_unspecified>
      <meta><name>last_used_at</name><rename>last_used_at</rename><type>Timestamp</type><length>-2</length><precision>-2</precision><conversion_mask>yyyy-MM-dd HH:mm:ss</conversion_mask><date_format_lenient>false</date_format_lenient><date_format_locale/><date_format_timezone>UTC</date_format_timezone><lenient_string_to_number>false</lenient_string_to_number><encoding/><decimal_symbol/><grouping_symbol/><currency_symbol/><storage_type/></meta>
      <meta><name>created_at</name><rename>created_at</rename><type>Timestamp</type><length>-2</length><precision>-2</precision><conversion_mask>yyyy-MM-dd HH:mm:ss</conversion_mask><date_format_lenient>false</date_format_lenient><date_format_locale/><date_format_timezone>UTC</date_format_timezone><lenient_string_to_number>false</lenient_string_to_number><encoding/><decimal_symbol/><grouping_symbol/><currency_symbol/><storage_type/></meta>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <GUI><xloc>648</xloc><yloc>64</yloc></GUI>
    <attributes/>
  </transform>
  <order>
    <hop><from>users (mssql)</from><to>stack both streams</to><enabled>Y</enabled></hop>
    <hop><from>company_users (mssql)</from><to>stack both streams</to><enabled>Y</enabled></hop>
    <hop><from>stack both streams</from><to>sort by identifier</to><enabled>Y</enabled></hop>
    <hop><from>sort by identifier</from><to>one login per identifier</to><enabled>Y</enabled></hop>
    <hop><from>one login per identifier</from><to>dates → Oslo</to><enabled>Y</enabled></hop>
    <hop><from>dates → Oslo</from><to>+ metaunit</to><enabled>Y</enabled></hop>
    <hop><from>+ metaunit</from><to>pick target columns</to><enabled>Y</enabled></hop>
    <hop><from>pick target columns</from><to>→ logins</to><enabled>Y</enabled></hop>
  </order>
  <notepads/>
  <attributes/>
  <transform_error_handling/>
</pipeline>
